# LOCAL CPU DEV PROFILE - NOT the design profile. This 4-core box reranks 13 pairs in ~500 ms (design: <45 ms on GPU FP16).
# Budgets are scaled only so the functional paths can be exercised; latency KPIs (07-09, 31-33) are NOT certifiable here
# and the scorecard reports every active override. Production/design profile = no overrides (agent/config.py defaults).
export MCP_MANIFEST_KEY=dev-only-local-key
export RERANK_BUDGET_MS=1500
export MCP_RAG_TIMEOUT_MS=2000
export STEP_TIMEOUT_MS=2000
export LOOP_BUDGET_MS=4000
export HF_HUB_OFFLINE=1
export INCIDENT_AUTOMATION=0   # local CPU always exceeds the 550 ms alert; the design profile leaves it on
